# 서버 포트
PORT=4000

# KIPRIS Plus OpenAPI 인증키 (https://plus.kipris.or.kr 에서 발급)
KIPRIS_API_KEY=여기에_발급받은_KIPRIS_API_KEY_입력
# KIPRIS Plus REST API 기본 URL (특별한 사유가 없으면 변경하지 마세요)
KIPRIS_BASE_URL=https://plus.kipris.or.kr/kipo-api/kipi

# 프론트엔드에서 접속을 허용할 Origin (쉼표로 여러 개 지정 가능)
CORS_ORIGIN=http://localhost:5173

# 첨부파일 저장 경로 및 최대 용량(MB)
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=20

# SQLite DB 파일 저장 경로
# Railway 등 컨테이너 배포 환경에서는 재배포 시 파일시스템이 초기화되므로,
# Volume을 마운트한 경로(예: /data)를 UPLOAD_DIR / DATA_DIR 로 지정해야 데이터가 보존됩니다.
DATA_DIR=./data

# ===== 메일 발송 설정 =====
# 컴플라이언스 담당자가 답변을 등록하면 문의자에게 자동으로 안내 메일을 발송합니다.
# 우선순위: SENDGRID_API_KEY > RESEND_API_KEY > SMTP (설정된 것 중 가장 앞선 것을 사용).
# Railway 등 클라우드 호스팅에서는 SMTP 포트(587/465)가 막히거나 타임아웃되는 경우가 많아
# 아래 두 HTTPS API 방식 중 하나를 권장합니다.

# --- SendGrid (도메인 없이 이메일 주소 1개만 인증해서 임의 수신자에게 발송 가능) ---
# https://sendgrid.com 무료 가입 (월 100통) → Settings → Sender Authentication →
# Single Sender Verification 에서 발신으로 쓸 이메일 주소를 인증(메일함으로 온 링크 클릭)한 뒤,
# 그 주소를 SENDGRID_FROM_EMAIL에 그대로 입력하세요. 도메인/DNS 설정이 필요 없습니다.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Resend (도메인을 인증하면 더 높은 발송량/깔끔한 발신주소 가능) ---
# https://resend.com 무료 가입 (월 3,000통). 도메인을 인증하지 않으면 "테스트 모드"라
# 가입 계정 본인 이메일로만 발송되니, 실제 문의자에게 보내려면 회사 도메인을 인증해야 합니다.
RESEND_API_KEY=
# 도메인을 인증했다면 그 도메인의 주소로 지정하세요 (예: noreply@company.com).
# 인증 전이라면 비워두면 resend.dev 기본 주소로 발송되지만 본인 이메일에만 도달합니다.
RESEND_FROM_EMAIL=

# SMTP_HOST 등 SMTP 계정 정보 (위 두 개가 모두 없을 때만 사용됨)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=여기에_발신용_계정_입력
SMTP_PASS=여기에_발신용_비밀번호_또는_앱비밀번호_입력
SMTP_FROM_NAME=KIPI 컴플라이언스팀
SMTP_FROM_EMAIL=여기에_발신용_계정_입력

# 문의 상세/답변을 확인할 수 있는 서비스 접속 주소 (메일 본문에 링크로 사용)
PUBLIC_WEB_URL=http://localhost:5173

# ===== 컴플라이언스 담당자 화면 접근 제한 (HTTP Basic Auth) =====
# 담당자들이 공유하는 아이디/비밀번호입니다. COMPLIANCE_PASSWORD를 설정하지 않으면
# 컴플라이언스 화면(및 답변 저장 API)이 보호되지 않으니 운영 환경에서는 반드시 설정하세요.
COMPLIANCE_USERNAME=compliance
COMPLIANCE_PASSWORD=여기에_담당자용_비밀번호_입력
